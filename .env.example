DATABASE_URL=postgresql://user:password@localhost:5432/cableeasy
JWT_SECRET=your-super-secret-jwt-key-change-this
NEXT_PUBLIC_APP_URL=https://ccn.atyant.in

# PayU (dashboard → Developer → API Keys). PAYU_KEY is accepted as an alias.
PAYU_MERCHANT_KEY=
PAYU_SALT=

# Payment alert emails via Resend (resend.com → API Keys)
RESEND_API_KEY=
# Optional: defaults to jatinraibjp@gmail.com / onboarding@resend.dev
PAYMENT_ALERT_EMAIL=
EMAIL_FROM=

# Telegram admin alerts (optional) — bot token from @BotFather, chat id(s) comma-separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron auth for /api/cron/* (daily plan-expiry reminders) — any long random string
CRON_SECRET=

# Direct UPI (PhonePe Business UPI ID customers pay to)
UPI_VPA=
UPI_PAYEE_NAME=
# UPI auto-verification: secret the SMS/notification-forwarder app sends (?key=... or x-sms-secret header)
SMS_WEBHOOK_SECRET=
# Optional: only trust these sender IDs, comma-separated partial match (e.g. HDFCBK,PhonePe Business)
UPI_SMS_ALLOWED_SENDERS=
# Optional: minutes an unpaid UPI order can still auto-verify (default 60)
UPI_MATCH_WINDOW_MINUTES=
